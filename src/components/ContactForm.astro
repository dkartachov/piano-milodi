---
import { t, type Lang } from '../i18n/strings';
import { site } from '../config/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const f = t[lang].contact.form;
---

<form class="contact-form" data-contact-form data-success={f.success} data-error={f.error} data-sending={f.sending}>
  <input type="hidden" name="access_key" value={site.web3formsKey} />
  <input type="hidden" name="subject" value={lang === 'fr' ? 'Nouveau message - Piano Milodi' : 'New message - Piano Milodi'} />
  <input type="hidden" name="from_name" value={site.name} />

  <!-- Honeypot: hidden from people, filled in by most spam bots. -->
  <label class="hp" aria-hidden="true">
    Leave this empty
    <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" />
  </label>

  <div class="field-row">
    <label class="field">
      <span>{f.name} <em aria-hidden="true">*</em></span>
      <input type="text" name="name" required autocomplete="name" />
    </label>
    <label class="field">
      <span>{f.email} <em aria-hidden="true">*</em></span>
      <input type="email" name="email" required autocomplete="email" />
    </label>
  </div>

  <label class="field">
    <span>{f.message} <em aria-hidden="true">*</em></span>
    <textarea name="message" rows="5" required placeholder={f.messagePlaceholder}></textarea>
  </label>

  <div class="form-footer">
    <button type="submit" class="btn btn-primary">{f.submit}</button>
    <p class="form-status" role="status" aria-live="polite"></p>
  </div>
</form>

<script>
  // Sends the form to Web3Forms (https://web3forms.com) as JSON.
  // Delegated on document so it keeps working after page transitions.
  document.addEventListener('submit', async (event) => {
    const form = event.target as HTMLFormElement | null;
    if (!(form instanceof HTMLFormElement) || !form.matches('[data-contact-form]')) return;
    event.preventDefault();

    const status = form.querySelector<HTMLParagraphElement>('.form-status')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const successMsg = form.dataset.success ?? 'Thank you!';
    const errorMsg = form.dataset.error ?? 'Something went wrong.';
    const sendingMsg = form.dataset.sending ?? 'Sending…';
    const originalLabel = button.textContent ?? '';

    // Honeypot check: silently pretend success for bots.
    const honeypot = form.querySelector<HTMLInputElement>('input[name="botcheck"]');
    if (honeypot?.checked) {
      form.reset();
      status.textContent = successMsg;
      return;
    }

    button.disabled = true;
    button.textContent = sendingMsg;
    status.textContent = '';
    status.classList.remove('is-error', 'is-success');

    const data = Object.fromEntries(new FormData(form).entries());
    delete data.botcheck;

    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(data),
      });
      const result = await response.json();

      if (response.ok && result.success) {
        form.reset();
        status.textContent = successMsg;
        status.classList.add('is-success');
      } else {
        throw new Error(result.message ?? 'Request failed');
      }
    } catch (err) {
      console.error(err);
      status.textContent = errorMsg;
      status.classList.add('is-error');
    } finally {
      button.disabled = false;
      button.textContent = originalLabel;
    }
  });
</script>

<style>
  .contact-form {
    display: grid;
    gap: 1.1rem;
  }
  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.1rem;
  }
  .field {
    display: grid;
    gap: 0.4rem;
  }
  .field > span {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--ink);
  }
  .field em {
    color: var(--muted);
    font-style: normal;
  }
  .field input,
  .field textarea {
    font: inherit;
    font-size: 1rem;
    color: var(--ink);
    background: #fffefa;
    border: 1px solid var(--ivory-edge);
    border-radius: 0;
    padding: 0.8rem 0.95rem;
    width: 100%;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .field textarea {
    resize: vertical;
    min-height: 130px;
  }
  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--ink);
    box-shadow: 0 0 0 3px rgba(5, 48, 82, 0.12);
  }
  .form-footer {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .form-status {
    margin: 0;
    font-size: 0.95rem;
    color: var(--muted);
  }
  .form-status.is-success {
    color: #2f6b3f;
  }
  .form-status.is-error {
    color: #9a2b2b;
  }
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  @media (max-width: 640px) {
    .field-row {
      grid-template-columns: 1fr;
    }
  }
</style>
