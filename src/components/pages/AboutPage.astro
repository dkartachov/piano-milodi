---
import { t, localePath, type Lang } from '../../i18n/strings';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = t[lang].about;
---

<section class="page-hero">
  <div class="wrap">
    <h1>{s.title}</h1>
  </div>
</section>

<section class="section about-section">
  <div class="wrap about-grid">
    <div class="portrait">
      <img src="/images/maria.jpg" alt="Maria" />
    </div>

    <div class="about-text">
      <p class="intro-title">{s.introTitle}</p>
      <p>{s.intro}</p>
      <p>{s.hobbies}</p>

      <h2 class="story-title">{s.storyTitle}</h2>
      {s.story.map((paragraph) => <p>{paragraph}</p>)}

      <div class="btn-row">
        <a class="btn btn-primary" href={localePath(lang, 'contact')}>{s.ctaButton}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }
  .portrait {
    aspect-ratio: 4 / 5;
    border-radius: 28px;
    border: 1px solid var(--line);
    box-shadow: var(--shadow-lg);
    position: sticky;
    top: 110px;
    overflow: hidden;
  }
  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .about-text p {
    font-size: 1.05rem;
  }
  .about-text .intro-title {
    font-family: var(--serif);
    font-size: clamp(2.3rem, 4vw, 3.2rem);
    line-height: 1.2;
    color: var(--ink);
    margin-bottom: 0.6rem;
  }
  .story-title {
    font-size: clamp(1.7rem, 2.8vw, 2.2rem);
    margin-top: 2.5rem;
  }
  @media (max-width: 860px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
    .portrait {
      position: relative;
      top: auto;
      max-width: 380px;
    }
  }
</style>
