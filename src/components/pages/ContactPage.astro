---
import ContactForm from '../ContactForm.astro';
import { t, type Lang } from '../../i18n/strings';
import { site } from '../../config/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = t[lang].contact;
// Searching the business name as well as the address makes the map show the Google listing, not just a bare address.
const mapQuery = encodeURIComponent(`${site.name}, ${site.address}`);
const mapSrc = `https://www.google.com/maps?q=${mapQuery}&hl=${lang}&output=embed`;
---

<section class="page-hero">
  <div class="wrap">
    <h1>{s.title}</h1>
    <p class="lead">{s.text}</p>
  </div>
</section>

<section class="section contact-section">
  <div class="wrap contact-grid">
    <div class="contact-info">
      <dl class="details">
        <dt>{s.phoneLabel}</dt>
        <dd><a href={`tel:${site.phone.replace(/-/g, '')}`}>{site.phone}</a></dd>
        <dt>{s.emailLabel}</dt>
        <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
        <dt>{s.addressLabel}</dt>
        <dd>{site.address}</dd>
      </dl>

      <div>
        <h2 class="section-title">{s.hoursTitle}</h2>
        <table class="hours">
          <tbody>
            {s.hours.map((row) => (
              <tr>
                <th scope="row">{row.day}</th>
                <td class={row.time.startsWith('Closed') || row.time.startsWith('Fermé') ? 'is-closed' : ''}>{row.time}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="hours-note">{s.hoursNote}</p>
      </div>
    </div>

    <div class="contact-side">
      <article class="card">
        <h2 class="section-title">{s.formTitle}</h2>
        <ContactForm lang={lang} />
      </article>

      <iframe
        class="map"
        title={s.mapTitle}
        src={mapSrc}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
      ></iframe>
    </div>
  </div>
</section>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 5vw, 4rem);
  }
  .contact-info {
    display: grid;
    align-content: start;
    gap: 2rem;
  }
  /* Form on top; the map stretches to line up with the bottom of the left column. */
  .contact-side {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .section-title {
    font-size: 1.85rem;
    margin-bottom: 1rem;
  }
  .hours {
    width: 100%;
    border-collapse: collapse;
  }
  .hours th,
  .hours td {
    padding: 0.6rem 0;
    border-bottom: 1px dashed var(--line);
    text-align: left;
    vertical-align: top;
  }
  .hours tr:last-child th,
  .hours tr:last-child td {
    border-bottom: none;
  }
  .hours th {
    font-weight: 500;
    width: 45%;
  }
  .hours td {
    font-variant-numeric: tabular-nums;
  }
  .hours td.is-closed {
    color: var(--muted);
    font-style: italic;
  }
  .hours-note {
    margin: 1rem 0 0;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .details {
    margin: 0;
    display: grid;
    gap: 0.35rem 1rem;
  }
  .details dt {
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 0.9rem;
  }
  .details dt:first-child {
    margin-top: 0;
  }
  .details dd {
    margin: 0;
    font-size: 1.05rem;
  }
  .details a {
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .map {
    width: 100%;
    flex: 1;
    min-height: 240px;
    border: 0;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    filter: grayscale(0.15) contrast(1.02);
  }
  @media (max-width: 860px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
