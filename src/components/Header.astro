---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { t, localePath, type Lang, type PageKey } from '../i18n/strings';
import { site } from '../config/site';

interface Props {
  lang: Lang;
  page: PageKey;
}

const { lang, page } = Astro.props;
const s = t[lang];
const navKeys: PageKey[] = ['home', 'about', 'contact', 'events'];
---

<header class="site-header">
  <div class="top-bar">
    <a class="site-name" href={localePath(lang, 'home')}>{site.name}</a>
    <div class="top-actions">
      <LanguageSwitcher lang={lang} page={page} />
      <details class="menu-mobile">
        <summary aria-label={lang === 'fr' ? 'Ouvrir le menu' : 'Open menu'}>
          <span class="menu-icon" aria-hidden="true"></span>
        </summary>
        <nav class="menu-mobile-panel" aria-label={lang === 'fr' ? 'Navigation mobile' : 'Mobile navigation'}>
          {navKeys.map((key) => (
            <a href={localePath(lang, key)} aria-current={key === page ? 'page' : undefined}>
              {s.nav[key]}
            </a>
          ))}
        </nav>
      </details>
    </div>
  </div>

  <nav class="nav-desktop" aria-label={lang === 'fr' ? 'Navigation principale' : 'Main navigation'}>
    {navKeys.map((key) => (
      <a href={localePath(lang, key)} aria-current={key === page ? 'page' : undefined}>
        {s.nav[key]}
      </a>
    ))}
  </nav>

  {page === 'home' && (
    <a class="brand" href={localePath(lang, 'home')}>
      <span class="brand-title">{s.brandTagline}</span>
      <span class="brand-sub">{s.subtitle}</span>
    </a>
  )}
</header>

<style>
  .site-header {
    background: var(--ivory);
    padding: 1rem 1rem 0;
  }

  /* Top row: site name in the true centre, language switch (and mobile menu button) on the right */
  .top-bar {
    width: min(100%, 1100px);
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
  }
  .site-name {
    grid-column: 2;
    font-size: clamp(2.6rem, 5vw, 4rem);
    font-weight: 300;
    line-height: 1.2;
    color: var(--ink);
    white-space: nowrap;
  }
  .top-actions {
    grid-column: 3;
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  /* Centered navigation, serif, as on the original */
  .nav-desktop {
    display: flex;
    justify-content: center;
    gap: 2.4rem;
    margin-top: 1.25rem;
    font-family: var(--nav);
    font-size: 1rem;
  }
  .nav-desktop a {
    color: var(--ink);
    padding-bottom: 0.2rem;
    border-bottom: 1px solid transparent;
  }
  .nav-desktop a:hover {
    border-bottom-color: var(--ink);
  }
  .nav-desktop a[aria-current='page'] {
    border-bottom-color: var(--ink);
  }

  /* Centered title block */
  .brand {
    display: block;
    text-align: center;
    margin: 3rem 0 2.25rem;
    color: var(--ink);
  }
  .brand-title {
    display: block;
    font-size: clamp(1.3rem, 2vw, 1.6rem);
    font-weight: 300;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    line-height: 1.1;
  }
  .brand-sub {
    display: block;
    font-size: 1.1rem;
    font-weight: 400;
    margin-top: 0.4rem;
  }

  /* Mobile menu */
  .menu-mobile {
    display: none;
    position: relative;
  }
  .menu-mobile summary {
    list-style: none;
    cursor: pointer;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 1px solid var(--ink);
    background: var(--ivory);
  }
  .menu-mobile summary::-webkit-details-marker {
    display: none;
  }
  .menu-icon,
  .menu-icon::before,
  .menu-icon::after {
    display: block;
    width: 18px;
    height: 2px;
    background: var(--ink);
    position: relative;
  }
  .menu-icon::before,
  .menu-icon::after {
    content: '';
    position: absolute;
  }
  .menu-icon::before {
    top: -6px;
  }
  .menu-icon::after {
    top: 6px;
  }
  .menu-mobile-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    min-width: 200px;
    background: var(--ivory);
    border: 1px solid var(--ink);
    padding: 0.4rem;
    display: flex;
    flex-direction: column;
    z-index: 60;
  }
  .menu-mobile-panel a {
    padding: 0.7rem 0.9rem;
    font-family: var(--nav);
    color: var(--ink);
  }
  .menu-mobile-panel a:hover,
  .menu-mobile-panel a[aria-current='page'] {
    background: var(--card);
  }

  @media (max-width: 860px) {
    .nav-desktop {
      display: none;
    }
    .menu-mobile {
      display: block;
    }
    /* Not enough room on one row: name on top, controls underneath */
    .top-bar {
      grid-template-columns: 1fr;
      justify-items: center;
      margin-bottom: 1rem;
    }
    .site-name,
    .top-actions {
      grid-column: 1;
    }
    .brand {
      margin-top: 1.5rem;
    }
  }
</style>
